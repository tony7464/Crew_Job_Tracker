    {
      "name": "Signup rejects password_hash",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/signup",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"hacker_{{stamp}}\",\"email\":\"hacker_{{stamp}}@example.com\",\"password\":\"password\",\"password_hash\":\"nope\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Signup Ada",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/signup",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"ada_{{stamp}}\",\"email\":\"ada_{{stamp}}@example.com\",\"password\":\"password\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('user has no password', () => {",
              "  pm.expect(body).to.not.have.property('password');",
              "  pm.expect(body).to.not.have.property('password_hash');",
              "  pm.expect(body.username).to.eql('ada_' + pm.collectionVariables.get('stamp'));",
              "});",
              "pm.collectionVariables.set('adaId', String(body.id));"
            ]
          }
        }
      ]
    },
